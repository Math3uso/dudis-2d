{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "compiler-ninja",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "compiler-vs2022",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "architecture": "x64"
        },
        {
            "name": "gcc-make",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "android",
            "inherits": "base",
            "displayName": "Build for Android",
            "binaryDir": "build/android",
            "cacheVariables": {
                "ANDROID": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-24"
            }
        },
        {
            "name": "desktop",
            "inherits": "base",
            "displayName": "Build for Desktop"
        },
        {
            "name": "desktop-release",
            "inherits": "base",
            "displayName": "Desktop Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "desktop-win32",
            "inherits": [
                "default",
                "compiler-vs2022"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "android",
            "configurePreset": "android"
        },
        {
            "name": "desktop",
            "configurePreset": "desktop"
        },
        {
            "name": "desktop-release",
            "configurePreset": "desktop-release"
        },
        {
            "name": "desktop-win32",
            "configurePreset": "desktop-win32"
        }
    ]
}